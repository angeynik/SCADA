# Настройки сервера SCADA BMS. Скопируйте в conf.env и измените под объект.
# Переменная окружения перекрывает значение из этого файла.
# Другой путь к файлу: переменная окружения CONF_ENV_FILE.
# Секреты сюда не записывать — только в окружение службы.

# Уровень логирования: error | info | dev | none
LOG_LEVEL=info

# Каталог данных сервера (относительный путь — от каталога сервера)
DATA_DIR=data

# Предельное время корректной остановки, мс (1000–120000)
SHUTDOWN_TIMEOUT_MS=10000

# Каталог конфигурации объекта: site.json, templates/, maps/, instances/
# (относительный путь — от каталога сервера). Образец — config/example, формат — docs/model.md
CONFIG_DIR=data/config

# Наибольшая пауза переподключения драйверов к контроллерам, мс (1000–600000).
# Пауза начинается с 1 с и удваивается, пока связи нет.
RECONNECT_MAX_MS=30000

# ── Modbus TCP (ОВЕН), docs/modbus-tcp.md ──
# Опрос включён: true | false
MODBUS_ENABLED=true
# Период опроса контроллера, мс (100–60000)
MODBUS_POLL_MS=1000
# Ожидание ответа на запрос, мс (100–30000)
MODBUS_TIMEOUT_MS=1000
# Ожидание TCP-подключения, мс (100–60000)
MODBUS_CONNECT_TIMEOUT_MS=3000
# Неудач подряд до признания связи потерянной (1–20)
MODBUS_FAIL_LIMIT=3
# Наибольший разрыв между точками в одном запросе, регистров (0–100)
MODBUS_MAX_GAP=4
