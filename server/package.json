{
  "name": "scada-bms-server",
  "version": "1.0.0",
  "appVersion": "0.0.0.1",
  "private": true,
  "description": "Сервер верхнего уровня BMS: Modbus TCP, BACnet/IP, OPC UA, архив, тревоги, WebSocket",
  "main": "server.js",
  "engines": {
    "node": ">=24.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js",
    "test:unit": "npm test -- tests/unit/",
    "test:integration": "npm test -- tests/integration/",
    "test:pg": "node tools/pgEmulator.js exec -- npm test",
    "pg:start": "node tools/pgEmulator.js start",
    "pg:stop": "node tools/pgEmulator.js stop",
    "pg:status": "node tools/pgEmulator.js status"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@bacnet-js/client": "^3.3.2",
    "bcryptjs": "^3.0.3",
    "dotenv": "^18.0.10",
    "joi": "^18.3.2",
    "modbus-serial": "^8.0.25",
    "node-opcua": "2.187.24",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "jest": "^30.5.2"
  }
}
